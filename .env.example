# Copie para .env e ajuste se necessário.
PORT=3000
# 0.0.0.0 para aceder a partir de outros dispositivos na rede (ex.: telemóvel na demonstração)
HOST=127.0.0.1
# Relativo à raiz do projecto; nunca dentro de client/ nem de simulador/
DB_PATH=server/data/lavaja.db
# Reposição da demonstração pela API (POST /api/admin/demo/reset). Vazio = desactivada.
# Exige o cabeçalho X-Demo-Token, { "confirm": "REPOR" } e acesso a partir da própria máquina.
DEMO_RESET_TOKEN=

# Sessões (I-11): segredo de assinatura dos tokens JWT, com pelo menos 32 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sem valor, é gerado um segredo aleatório e as sessões terminam ao reiniciar o servidor.
JWT_SECRET=
# true quando o servidor estiver atrás de HTTPS (cookies de sessão só por HTTPS).
COOKIE_SECURE=false
# Endereço público usado nos links da conversa (pagamento). Para abrir num telemóvel na mesma rede,
# use o IP da máquina, ex.: http://192.168.1.20:3000 (e HOST=0.0.0.0).
PUBLIC_URL=http://localhost:3000
