# Copie para .env e ajuste se necessário.
PORT=3000
# 0.0.0.0 para aceder a partir de outros dispositivos na rede (ex.: telemóvel na demonstração)
HOST=127.0.0.1
# Relativo à raiz do projecto; nunca dentro de client/ nem de simulador/
DB_PATH=server/data/lavaja.db
# Reposição da demonstração pela API (POST /api/admin/demo/reset). Vazio = desactivada.
# Exige o cabeçalho X-Demo-Token, { "confirm": "REPOR" } e acesso a partir da própria máquina.
DEMO_RESET_TOKEN=
